{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omniroute-mcp-messages.schema.json",
  "title": "OmniRoute MCP JSON-RPC Messages Schema",
  "description": "Schema for validating MCP JSON-RPC 2.0 request and response messages used in OmniRoute MCP Streamable HTTP transport.",
  "definitions": {
    "jsonrpc_request": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            { "type": "string" },
            { "type": "integer" }
          ],
          "description": "Request identifier. Must be present for requests expecting a response."
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "description": "The MCP method to invoke."
        },
        "params": {
          "type": "object",
          "description": "Parameters for the method call."
        }
      },
      "required": ["jsonrpc", "method"],
      "additionalProperties": false
    },
    "jsonrpc_success_response": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            { "type": "string" },
            { "type": "integer" }
          ]
        },
        "result": {
          "description": "The result of the method invocation."
        }
      },
      "required": ["jsonrpc", "id", "result"],
      "additionalProperties": false
    },
    "jsonrpc_error_response": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "oneOf": [
            { "type": "string" },
            { "type": "integer" },
            { "type": "null" }
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string" },
            "data": {}
          },
          "required": ["code", "message"]
        }
      },
      "required": ["jsonrpc", "id", "error"],
      "additionalProperties": false
    },
    "initialize_params": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "string",
          "description": "MCP protocol version."
        },
        "capabilities": {
          "type": "object",
          "description": "Client capabilities declaration."
        },
        "clientInfo": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          },
          "required": ["name", "version"]
        }
      },
      "required": ["protocolVersion", "capabilities", "clientInfo"]
    },
    "initialize_result": {
      "type": "object",
      "properties": {
        "protocolVersion": { "type": "string" },
        "capabilities": { "type": "object" },
        "serverInfo": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          },
          "required": ["name"]
        }
      },
      "required": ["protocolVersion", "capabilities", "serverInfo"]
    },
    "tools_list_result": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "inputSchema": {
                "type": "object",
                "description": "JSON Schema for the tool's input parameters."
              }
            },
            "required": ["name", "inputSchema"]
          }
        }
      },
      "required": ["tools"]
    },
    "tool_call_params": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the tool to call."
        },
        "arguments": {
          "type": "object",
          "description": "Arguments matching the tool's inputSchema."
        }
      },
      "required": ["name"]
    },
    "known_error_codes": {
      "description": "Known application-level error codes from the OmniRoute gateway.",
      "type": "string",
      "enum": [
        "INVALID_INPUT",
        "INVALID_PROFILE",
        "INVALID_CACHE_MODE",
        "CACHE_KEY_REQUIRED",
        "CONFIG_MISSING",
        "GATEWAY_UNREACHABLE"
      ]
    }
  }
}
