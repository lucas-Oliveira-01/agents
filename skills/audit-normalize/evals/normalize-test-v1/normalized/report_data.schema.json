          "type": "string",
          "minLength": 1
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "subcategory": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "$ref": "#/$defs/findingTypeField"
        },
        "status": {
          "$ref": "#/$defs/statusField"
        },
        "severity": {
          "$ref": "#/$defs/severityField"
        },
        "confidence": {
          "$ref": "#/$defs/confidenceField"
        },
        "location": {
          "$ref": "#/$defs/locationField"
        },
        "evidence": {
          "$ref": "#/$defs/semanticTextField"
        },
        "description": {
          "$ref": "#/$defs/semanticTextField"
        },
        "cause": {
          "$ref": "#/$defs/semanticTextField"
        },
        "impact": {
          "$ref": "#/$defs/semanticTextField"
        },
        "exploitability": {
          "$ref": "#/$defs/semanticTextField"
        },
        "recommendation": {
          "$ref": "#/$defs/semanticTextField"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 1
        }
      }
    },
    "control": {
      "type": "object",
