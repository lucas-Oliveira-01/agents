              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "enum": [
                  "P0",
                  "P1",
                  "P2",
                  "P3",
                  "INFO"
                ]
              },
              "conflict_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "NOT_PROVIDED_BY_SOURCE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "conflict_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "NOT_DETERMINABLE"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "value": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "conflict_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "CONFLICT"
              }
            }
          },
          "then": {
            "required": [
              "conflict_id"
            ],
            "properties": {
              "value": {
                "type": "null"
              },
              "conflict_id": {
                "$ref": "#/$defs/conflictId"
              }
            }
          }
        }
      ]
    },
