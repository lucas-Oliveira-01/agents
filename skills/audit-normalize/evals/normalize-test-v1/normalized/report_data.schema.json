{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audit-pipeline.local/schema/report-data.schema.json",
  "title": "Audit Pipeline Canonical Report Data",
  "description": "Canonical normalized audit dataset produced by audit-normalize.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "target_project",
    "audit_snapshot",
    "applicability",
    "inspections",
    "findings",
    "controls",
    "anomalies",
    "conflicts",
    "metrics",
    "limitations",
    "references"
  ],
  "properties": {
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "target_project": {
      "$ref": "#/$defs/targetProject"
    },
    "audit_snapshot": {
      "$ref": "#/$defs/auditSnapshot"
    },
    "applicability": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/applicability"
      }
    },
    "inspections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inspection"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "anomalies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anomaly"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/limitation"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generator",
        "generated_at"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "generator": {
          "const": "audit-normalize"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "sourceId": {
      "type": "string",
      "pattern": "^src-[A-Za-z0-9._-]+$"
    },
    "findingId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3,}$"
    },
    "controlId": {
      "type": "string",
      "pattern": "^CONTROL-[0-9]{3,}$"
    },
    "anomalyId": {
      "type": "string",
      "pattern": "^ANOM-[0-9]{3,}$"
    },
    "conflictId": {
      "type": "string",
      "pattern": "^CONFLICT-[0-9]{3,}$"
    },
    "limitationId": {
      "type": "string",
      "pattern": "^LIMIT-[0-9]{3,}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "SECURITY",
        "ARCHITECTURE",
        "DOMAIN",
        "DATABASE",
        "BUILD",
        "TESTING",
        "CI_CD",
        "INFRASTRUCTURE",
        "CONFIGURATION",
        "DOCUMENTATION",
        "OPERATIONS",
        "CODE_QUALITY"
      ]
    },
    "sourceRole": {
      "type": "string",
      "enum": [
        "AUDIT_LEDGER",
        "ANALYTICAL_REPORT",
        "INVENTORY",
        "THREAT_MODEL",
        "COVERAGE_MANIFEST",
        "EXTERNAL_REVIEW",
        "ENVIRONMENT",
        "VCS",
        "UNKNOWN"
      ]
    },
    "findingType": {
      "type": "string",
      "enum": [
        "BUG",
        "TECHNICAL_DEFECT",
        "VULNERABILITY",
        "RISK",
        "INCONSISTENCY",
        "TECH_DEBT",
        "OPERATIONAL_PROBLEM",
        "ARCHITECTURAL_DEFECT",
        "ARCHITECTURAL_IMPROVEMENT",
        "REQUIREMENT_DEPENDENT"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line_range": {
          "type": [
            "array",
            "null"
          ],
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "confidence_at_source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            null
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "file",
        "sha256",
        "source_role"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_role": {
          "$ref": "#/$defs/sourceRole"
        }
      }
    },
    "auditSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "created_at",
        "sources"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "sourceBackedString": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value",
        "provenance"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "PRESENT",
            "NOT_PROVIDED_BY_SOURCE",
            "NOT_DETERMINABLE",
            "CONFLICT"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "conflict_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^CONFLICT-[0-9]{3,}$"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "PRESENT"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "conflict_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "NOT_PROVIDED_BY_SOURCE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "conflict_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "NOT_DETERMINABLE"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "value": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "conflict_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "CONFLICT"
              }
            }
          },
          "then": {
            "required": [
              "conflict_id"
            ],
            "properties": {
              "value": {
                "type": "null"
              },
              "conflict_id": {
                "$ref": "#/$defs/conflictId"
              }
            }
          }
        }
      ]
    },
    "targetProject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "branch",
        "version",
        "build_version"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/sourceBackedString"
        },
        "commit": {
          "$ref": "#/$defs/sourceBackedString"
        },
        "branch": {
          "$ref": "#/$defs/sourceBackedString"
        },
        "version": {
          "$ref": "#/$defs/sourceBackedString"
        },
        "build_version": {
          "$ref": "#/$defs/sourceBackedString"
        }
      }
    },
    "semanticTextField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "value"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "PRESENT",
            "NOT_PROVIDED_BY_SOURCE",
            "NOT_DETERMINABLE",
            "CONFLICT"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "conflict_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^CONFLICT-[0-9]{3,}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "PRESENT"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "conflict_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "NOT_PROVIDED_BY_SOURCE",
                  "NOT_DETERMINABLE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "conflict_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "NOT_DETERMINABLE"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "CONFLICT"
              }
            }
          },
          "then": {
            "required": [
              "conflict_id"
            ],
            "properties": {
              "value": {
                "type": "null"
              },
              "conflict_id": {
                "$ref": "#/$defs/conflictId"
              }
            }
          }
        }
      ]
    },
    "severityField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
