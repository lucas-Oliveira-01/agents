          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "INSPECTED",
            "PARTIALLY_INSPECTED",
            "NOT_INSPECTED",
            "NOT_DETERMINABLE"
          ]
        },
        "result": {
          "type": "string",
          "enum": [
            "FINDINGS_PRESENT",
            "NOT_FOUND",
            "NOT_DETERMINABLE"
          ]
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 1
        }
      }
    },
    "finding": {
      "type": "object",
