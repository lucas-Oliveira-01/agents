        "file",
        "line_start",
        "line_end"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "locationField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "PRESENT",
            "NOT_PROVIDED_BY_SOURCE",
            "NOT_DETERMINABLE",
            "CONFLICT"
          ]
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/locationFileOnly"
            },
            {
              "$ref": "#/$defs/locationWithLine"
            },
            {
              "$ref": "#/$defs/locationWithRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "conflict_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^CONFLICT-[0-9]{3,}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "PRESENT"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/locationFileOnly"
                  },
                  {
                    "$ref": "#/$defs/locationWithLine"
                  },
                  {
                    "$ref": "#/$defs/locationWithRange"
                  }
                ]
              },
              "conflict_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "NOT_PROVIDED_BY_SOURCE"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "conflict_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "NOT_DETERMINABLE"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "value": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "conflict_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "CONFLICT"
              }
            }
          },
          "then": {
            "required": [
              "conflict_id"
            ],
            "properties": {
              "value": {
                "type": "null"
              },
              "conflict_id": {
                "$ref": "#/$defs/conflictId"
              }
            }
          }
        }
      ]
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "subcategory",
        "state",
        "provenance"
