      }
    },
    "conflictResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "policy_applied",
        "selected_source"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "RESOLVED",
            "UNRESOLVED"
          ]
        },
        "policy_applied": {
          "type": [
            "string",
            "null"
          ]
        },
        "selected_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/sourceId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "RESOLVED"
              }
            }
          },
          "then": {
            "properties": {
              "policy_applied": {
                "type": "string",
                "minLength": 1
              },
              "selected_source": {
                "$ref": "#/$defs/sourceId"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNRESOLVED"
              }
            }
          },
          "then": {
            "properties": {
              "selected_source": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "field",
        "resolution",
        "values"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/conflictId"
        },
        "type": {
          "type": "string",
          "enum": [
            "SEVERITY_CONFLICT",
            "STATUS_CONFLICT",
            "CONFIDENCE_CONFLICT",
            "TYPE_CONFLICT",
            "LOCATION_CONFLICT",
            "FIELD_VALUE_CONFLICT",
            "IDENTITY_CONFLICT",
            "TARGET_PROJECT_CONFLICT"
          ]
        },
        "finding_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3,}$"
        },
        "field": {
