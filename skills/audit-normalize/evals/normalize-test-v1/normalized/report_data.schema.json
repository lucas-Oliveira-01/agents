          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "conflict_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^CONFLICT-[0-9]{3,}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
