+# ===========================================================================
+# Snapshot drift must stop execution and preserve a recovery point
+# ===========================================================================
+
+
+class TestSnapshotDriftEnforcement:
+    def test_drift_detected_before_dispatch_stops_without_attempt(self, orchestrator, target_snapshot, execution_policy, egress_policy):
+        plan, plan_id = _make_plan(target_snapshot, execution_policy, egress_policy)
+        wi = make_work_item(
+            plan_id=plan_id, auditor="security-audit",
+            execution_policy=execution_policy, egress_policy=egress_policy
+        )
+        calls = iter(["b" * 64])
+        auditor = FakeAuditorWithSnapshot(target_snapshot.snapshot_fingerprint, FakeAuditorResult.SUCCESS)
+
+        run = orchestrator.execute_vertical_slice(
+            snapshot=target_snapshot,
+            plan=plan,
+            work_items=[wi],
+            auditor=auditor,
+            current_snapshot_provider=lambda: next(calls),
+        )
+
+        assert run.failure_state == RunFailureState.SNAPSHOT_DRIFT
+        assert run.execution_completeness == RunExecutionCompleteness.PARTIAL
+        assert run.coverage_completeness == RunCoverageCompleteness.NONE
+        assert wi.execution_state == ExecutionState.PLANNED
+        assert wi.attempts == []
+
+    def test_drift_after_worker_return_preserves_running_recovery_point(self, orchestrator, target_snapshot, execution_policy, egress_policy):
+        plan, plan_id = _make_plan(target_snapshot, execution_policy, egress_policy)
+        wi = make_work_item(
+            plan_id=plan_id, auditor="security-audit",
+            execution_policy=execution_policy, egress_policy=egress_policy
+        )
+        calls = iter([target_snapshot.snapshot_fingerprint, "b" * 64])
+        auditor = FakeAuditorWithSnapshot(target_snapshot.snapshot_fingerprint, FakeAuditorResult.SUCCESS)
+
+        run = orchestrator.execute_vertical_slice(
+            snapshot=target_snapshot,
+            plan=plan,
+            work_items=[wi],
+            auditor=auditor,
+            current_snapshot_provider=lambda: next(calls),
+        )
+
+        assert run.failure_state == RunFailureState.SNAPSHOT_DRIFT
+        assert run.execution_completeness == RunExecutionCompleteness.PARTIAL
+        assert run.coverage_completeness == RunCoverageCompleteness.NONE
+        assert wi.execution_state == ExecutionState.RUNNING
+        assert len(wi.attempts) == 1
+        assert not wi.attempts[0].is_finished
+        assert orchestrator.store.list_evidence_ids() == []
+
+
